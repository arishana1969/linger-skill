{
  "name": "continuity-skill",
  "version": "0.0.1",
  "description": "File-native conversation archive and decision trail continuity for coding agents.",
  "type": "module",
  "bin": { "continuity": "dist/cli.js" },
  "files": ["dist", "!dist/*.test.*", "skills", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
